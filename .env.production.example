# env — PRODUCTION template. Do NOT commit real secrets.
# Fill real values in the Zeabur service dashboard (Environment Variables),
# not in this file. Copy locally only for reference: cp .env.production.example .env.production
# .env.production is gitignored and never committed.

NODE_ENV=production
# PORT is injected by Zeabur. Do not hardcode. Code falls back to 5000 locally.
# PORT=5000
SERVER_URL=https://env-backend.elzipodev.cv
CLIENT_URL=https://env.elzipodev.cv

# Postgres — production DB reachable from Zeabur (Zeabur Postgres plugin, Neon, Supabase).
# After setting, run once from your machine: DATABASE_URL=<prod-url> npm run db:push
DATABASE_URL=postgres://user:password@host:5432/env_prod

# betterAuth — baseURL MUST be the public backend URL or Google + session cookies break.
BETTER_AUTH_SECRET=replace_with_random_32plus_chars_see_below
BETTER_AUTH_URL=https://env-backend.elzipodev.cv
GOOGLE_CLIENT_ID=paste_from_google_console
GOOGLE_CLIENT_SECRET=paste_from_google_console
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Key protection — REUSE your existing dev ENCRYPTION_KEY if the prod DB
# already holds ciphertext (or you migrate rows). A new key makes old
# ciphertext unreadable. Fresh DB only:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=paste_existing_or_new_64_hex_chars

# OTP gate
OTP_TTL_MINUTES=30
OTP_LENGTH=6

# Email provider
EMAIL_PROVIDER=sendlib
SENDLIB_API_KEY=paste_existing_key
SENDLIB_FROM_EMAIL=your_connected_gmail@gmail.com
SENDLIB_FROM_NAME=env
# Inbox shows: "env" <your_connected_gmail@gmail.com>
