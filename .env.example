# env — example env. Copy to .env: cp .env.example .env
# Backend (Node + Express, root) — required keys

NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Postgres — use your own DB (Neon / Supabase / local)
DATABASE_URL=postgres://user:password@localhost:5432/env

# betterAuth
BETTER_AUTH_SECRET=replace_with_32plus_char_random_string
BETTER_AUTH_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Key protection — AES-256-GCM (required to view/copy later; one-way hash cannot be revealed)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# OTP gate — v1: required to view one or all keys in a project
OTP_TTL_MINUTES=30
OTP_LENGTH=6

# Email provider — pluggable. Default: sendlib. Future: smtp / resend
EMAIL_PROVIDER=sendlib
SENDLIB_API_KEY=
SENDLIB_FROM_EMAIL=sender@gmail.com
SENDLIB_FROM_NAME=env
# From is sent as "env" <sender@gmail.com> so inbox shows our brand only.
# Sendlib API: POST https://sendlib.samueltuoyo.com/api/send with Bearer SENDLIB_API_KEY
